{
  "说明": "桌宠本地指令表（触发词机制）。未命中任何规则 → 走主会话闲聊。action: dispatch(派发任务) | interrupt(打断任务) | task_status(任务状态本地直答) | new_chat(新开对话) | history(查询记录) | steer_task(跟任务说) | mute(静音,M2) | help(帮助)。type: prefix(前缀) | contains(包含) | regex(正则)。",
  "rules": [
    {
      "type": "prefix",
      "pattern": "执行任务：",
      "action": "dispatch",
      "note": "强制派发，内容即任务"
    },
    {
      "type": "prefix",
      "pattern": "任务：",
      "action": "dispatch",
      "note": "强制派发"
    },
    {
      "type": "prefix",
      "pattern": "帮我执行：",
      "action": "dispatch",
      "note": "强制派发"
    },
    {
      "type": "prefix",
      "pattern": "帮我查一下",
      "action": "dispatch",
      "note": "长前缀优先于「帮我查」（顺序即优先级）",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我查查",
      "action": "dispatch",
      "note": "防「帮我查」截剩「查」残缺",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我查",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "查一下",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我搜索",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我搜",
      "action": "dispatch",
      "note": "短触发词，排在「帮我搜索」之后",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "搜索一下",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我找一下",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我找",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我下载一下",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我下载",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "帮我打开",
      "action": "dispatch",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "打开",
      "action": "dispatch",
      "matchType": "prefixStrict",
      "note": "词边界：「打开思路」不命中，「打开 Apple Music」命中",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "搜索",
      "action": "dispatch",
      "matchType": "prefixStrict",
      "note": "词边界：防「搜索X」单字误伤",
      "excludePrefixes": [
        "我的心情",
        "心情",
        "心结",
        "对象",
        "想法",
        "脸色"
      ]
    },
    {
      "type": "prefix",
      "pattern": "跟任务说：",
      "action": "steer_task",
      "note": "转向运行中任务"
    },
    {
      "type": "contains",
      "pattern": "打断任务",
      "action": "interrupt"
    },
    {
      "type": "contains",
      "pattern": "停止任务",
      "action": "interrupt"
    },
    {
      "type": "contains",
      "pattern": "中断任务",
      "action": "interrupt",
      "note": "自然用语补充（用户实测未命中缺口）"
    },
    {
      "type": "contains",
      "pattern": "取消任务",
      "action": "interrupt",
      "note": "与 delete_task（前缀「删除任务：」）不冲突——prefix 语义不会误命中"
    },
    {
      "type": "contains",
      "pattern": "停一下",
      "action": "interrupt"
    },
    {
      "type": "contains",
      "pattern": "停下来",
      "action": "interrupt",
      "note": "「停」单字太宽不加"
    },
    {
      "type": "prefix",
      "pattern": "停止回答",
      "action": "interrupt_main",
      "note": "v10 三分控制：只停主 Agent 当前回复，任务侧不动（前缀语义——非宽泛 contains，否定句「请不要停止回答」不命中）"
    },
    {
      "type": "prefix",
      "pattern": "全部停止",
      "action": "interrupt_all",
      "note": "v10 三分控制：主 Agent 回复与任务 Agent 同时收口"
    },
    {
      "type": "contains",
      "pattern": "还在工作吗",
      "action": "task_status",
      "note": "v3：本地直答任务状态（零延迟），不绕主 Agent"
    },
    {
      "type": "contains",
      "pattern": "在工作吗",
      "action": "task_status"
    },
    {
      "type": "contains",
      "pattern": "任务状态",
      "action": "task_status"
    },
    {
      "type": "contains",
      "pattern": "任务进度",
      "action": "task_status"
    },
    {
      "type": "contains",
      "pattern": "任务做完了吗",
      "action": "task_status"
    },
    {
      "type": "prefix",
      "pattern": "打断",
      "action": "interrupt",
      "note": "短触发词，需唤醒后使用（M3）"
    },
    {
      "type": "contains",
      "pattern": "新开对话",
      "action": "new_chat"
    },
    {
      "type": "contains",
      "pattern": "新会话",
      "action": "new_chat"
    },
    {
      "type": "contains",
      "pattern": "聊天记录",
      "action": "history"
    },
    {
      "type": "contains",
      "pattern": "查询记录",
      "action": "history"
    },
    {
      "type": "contains",
      "pattern": "最近对话",
      "action": "history"
    },
    {
      "type": "contains",
      "pattern": "帮助",
      "action": "help"
    },
    {
      "type": "contains",
      "pattern": "你能做什么",
      "action": "help"
    },
    {
      "type": "prefix",
      "pattern": "删除任务：",
      "action": "delete_task",
      "note": "删除指定任务会话（按标题匹配最近）"
    },
    {
      "type": "contains",
      "pattern": "删除对话历史",
      "action": "delete_history",
      "note": "级联删主会话及全部任务会话（删除前确认）"
    },
    {
      "type": "contains",
      "pattern": "清空对话",
      "action": "delete_history"
    },
    {
      "type": "contains",
      "pattern": "静音",
      "action": "mute",
      "note": "切换播报静音",
      "matchType": "prefixStrict"
    },
    {
      "type": "regex",
      "pattern": "^请?帮我(执行|运行)\\S",
      "action": "dispatch",
      "note": "v4 高置信直派：帮我/请帮我+执行/运行（至少一个对象字符）——完整原文直传任务 Agent（不剥前缀）"
    },
    {
      "type": "regex",
      "pattern": "^请?帮我(写|编写|改|修改|创建|新建|生成|整理|删除|移除|修复|测试|编译|查看|阅读|保存)(一下|下|个|份|段|点|一个|一份|一段|一点)?[^，。！？、,.!?;:]{0,12}?(文件|代码|脚本|命令|目录|项目|文档)",
      "action": "dispatch",
      "note": "v4 高置信直派：帮我/请帮我+文件/代码/脚本/命令/目录/项目/文档类操作——对象名词锚定；「帮我整理一下思路」等无工具对象闲聊不劫持"
    }
  ]
}